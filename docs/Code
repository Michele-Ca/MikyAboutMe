import * as React from "react"
import { useRef, useEffect, useState } from "react"
import { motion, useScroll, useTransform, useSpring, useInView } from "framer-motion"
import { addPropertyControls, ControlType } from "framer"

/**
 * ABOUT ME — Viaggi, Ghibli & Creatività
 * Un'esperienza dinamica con scroll 3D, parallasse e micro-interazioni.
 *
 * @framerSupportedLayoutWidth any-prefer-fixed
 * @framerSupportedLayoutHeight any-prefer-fixed
 * @framerIntrinsicWidth 1440
 * @framerIntrinsicHeight 3000
 */

// ── ICONE SVG INLINE ────────────────────────────────────────────
const CompassIcon = ({ size = 24 }) => (
    <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
        <circle cx="12" cy="12" r="10" />
        <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
    </svg>
)

const SparklesIcon = ({ size = 24 }) => (
    <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
        <path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6L5.6 18.4" />
    </svg>
)

const FilmIcon = ({ size = 24 }) => (
    <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
        <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18" />
        <line x1="7" y1="2" x2="7" y2="22" />
        <line x1="17" y1="2" x2="17" y2="22" />
        <line x1="2" y1="12" x2="22" y2="12" />
        <line x1="2" y1="7" x2="7" y2="7" />
        <line x1="2" y1="17" x2="7" y2="17" />
        <line x1="17" y1="17" x2="22" y2="17" />
        <line x1="17" y1="7" x2="22" y2="7" />
    </svg>
)

// ── COMPONENTE PRINCIPALE ──────────────────────────────────────
export default function AboutMePage(props) {
    const {
        // Contenuto
        name = "Michele",
        tagline = "Viaggiatore, sognatore, creatore di storie",
        // Sezione Viaggi
        travelTitle = "Viaggi",
        travelDescription = "Ogni viaggio è una storia. Dalle strade di Copenhagen ai sentieri nascosti della mia terra, colleziono momenti, non cose. Ogni destinazione mi ha insegnato qualcosa di nuovo sul mondo e su me stesso.",
        travelImage = "https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=1200",
        // Sezione Ghibli
        ghibliTitle = "Studio Ghibli",
        ghibliDescription = "Il mio immaginario è popolato da spiriti della foresta, città incantate e macchine volanti. Miyazaki mi ha insegnato che la magia è ovunque, basta saper guardare. La mia creatività nasce da lì: da un mondo dove tutto è possibile.",
        ghibliImage = "https://images.unsplash.com/photo-1542051841857-5f90071e7989?w=1200",
        // Sezione Creatività
        creativityTitle = "Creatività",
        creativityDescription = "Traduco emozioni in codice, pixel e parole. Progetto esperienze digitali che spero lascino un segno, come un fotogramma di un film che ti rimane dentro.",
        creativityImage = "https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=1200",
        // Colori
        bgColor = "#0A0A0A",
        textColor = "#FFFFFF",
        accentColor = "#0EA5E9",
        // Layout
        cardWidth = 420,
    } = props

    const containerRef = useRef(null)
    const { scrollYProgress } = useScroll({ target: containerRef, offset: ["start start", "end end"] })

    // Spring per smoothing dello scroll
    const smoothProgress = useSpring(scrollYProgress, { stiffness: 100, damping: 30, restDelta: 0.001 })

    // Trasformazioni parallasse per le sezioni
    const travelY = useTransform(smoothProgress, [0, 0.3], [0, -150])
    const travelOpacity = useTransform(smoothProgress, [0, 0.15, 0.3], [1, 0.8, 0])
    const ghibliY = useTransform(smoothProgress, [0.2, 0.5], [150, -150])
    const ghibliOpacity = useTransform(smoothProgress, [0.2, 0.35, 0.5], [0, 0.9, 0])
    const creativityY = useTransform(smoothProgress, [0.4, 0.7], [150, -150])
    const creativityOpacity = useTransform(smoothProgress, [0.4, 0.55, 0.7], [0, 0.9, 0])

    // Tilt 3D del titolo principale
    const heroRotateX = useTransform(smoothProgress, [0, 0.2], [0, 12])

    return (
        <div
            ref={containerRef}
            style={{
                width: "100%",
                minHeight: "300vh",
                background: bgColor,
                color: textColor,
                position: "relative",
                overflowX: "hidden",
                fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
            }}
        >
            {/* ── HERO SECTION ── */}
            <section
                style={{
                    height: "100vh",
                    display: "flex",
                    flexDirection: "column",
                    alignItems: "center",
                    justifyContent: "center",
                    padding: "0 24px",
                    position: "relative",
                    perspective: 1200,
                }}
            >
                <motion.div
                    style={{ rotateX: heroRotateX, transformStyle: "preserve-3d" }}
                >
                    <motion.h1
                        initial={{ opacity: 0, y: 40 }}
                        animate={{ opacity: 1, y: 0 }}
                        transition={{ duration: 1, ease: [0.22, 1, 0.36, 1] }}
                        style={{
                            fontSize: "clamp(48px, 8vw, 120px)",
                            fontWeight: 800,
                            textAlign: "center",
                            letterSpacing: "-0.04em",
                            lineHeight: 1,
                            marginBottom: 24,
                            background: `linear-gradient(180deg, ${textColor} 0%, ${accentColor} 100%)`,
                            WebkitBackgroundClip: "text",
                            WebkitTextFillColor: "transparent",
                        }}
                    >
                        {name}
                    </motion.h1>
                    <motion.p
                        initial={{ opacity: 0, y: 20 }}
                        animate={{ opacity: 1, y: 0 }}
                        transition={{ duration: 1, delay: 0.3, ease: [0.22, 1, 0.36, 1] }}
                        style={{
                            fontSize: "clamp(18px, 2vw, 24px)",
                            textAlign: "center",
                            opacity: 0.7,
                            maxWidth: 600,
                            margin: "0 auto",
                        }}
                    >
                        {tagline}
                    </motion.p>
                </motion.div>

                {/* Indicatore di scroll */}
                <motion.div
                    animate={{ y: [0, 10, 0] }}
                    transition={{ duration: 2, repeat: Infinity, ease: "easeInOut" }}
                    style={{
                        position: "absolute",
                        bottom: 40,
                        left: "50%",
                        transform: "translateX(-50%)",
                        display: "flex",
                        flexDirection: "column",
                        alignItems: "center",
                        gap: 8,
                        opacity: 0.5,
                    }}
                >
                    <span style={{ fontSize: 12, letterSpacing: 2, textTransform: "uppercase" }}>Scorri</span>
                    <div style={{ width: 1, height: 40, background: accentColor }} />
                </motion.div>
            </section>

            {/* ── SEZIONE VIAGGI ── */}
            <motion.section
                style={{
                    height: "100vh",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    padding: "0 24px",
                    position: "relative",
                    y: travelY,
                    opacity: travelOpacity,
                    perspective: 1200,
                }}
            >
                <div style={{ display: "flex", alignItems: "center", gap: 60, maxWidth: 1200, width: "100%", flexWrap: "wrap", justifyContent: "center" }}>
                    <motion.div
                        whileHover={{ scale: 1.05, rotateY: 5 }}
                        transition={{ type: "spring", stiffness: 200, damping: 20 }}
                        style={{
                            width: cardWidth,
                            height: cardWidth * 1.2,
                            borderRadius: 24,
                            overflow: "hidden",
                            boxShadow: `0 40px 80px rgba(0,0,0,0.5)`,
                            transformStyle: "preserve-3d",
                        }}
                    >
                        <img src={travelImage} alt={travelTitle} style={{ width: "100%", height: "100%", objectFit: "cover" }} />
                    </motion.div>
                    <div style={{ maxWidth: 480 }}>
                        <div style={{ display: "flex", alignItems: "center", gap: 12, marginBottom: 16, color: accentColor }}>
                            <CompassIcon size={28} />
                            <h2 style={{ fontSize: "clamp(32px, 4vw, 56px)", fontWeight: 700, margin: 0, letterSpacing: "-0.02em" }}>
                                {travelTitle}
                            </h2>
                        </div>
                        <p style={{ fontSize: 18, lineHeight: 1.7, opacity: 0.8 }}>
                            {travelDescription}
                        </p>
                    </div>
                </div>
            </motion.section>

            {/* ── SEZIONE GHIBLI ── */}
            <motion.section
                style={{
                    height: "100vh",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    padding: "0 24px",
                    position: "relative",
                    y: ghibliY,
                    opacity: ghibliOpacity,
                    perspective: 1200,
                }}
            >
                <div style={{ display: "flex", flexDirection: "row-reverse", alignItems: "center", gap: 60, maxWidth: 1200, width: "100%", flexWrap: "wrap", justifyContent: "center" }}>
                    <motion.div
                        whileHover={{ scale: 1.05, rotateY: -5 }}
                        transition={{ type: "spring", stiffness: 200, damping: 20 }}
                        style={{
                            width: cardWidth,
                            height: cardWidth * 1.2,
                            borderRadius: 24,
                            overflow: "hidden",
                            boxShadow: `0 40px 80px rgba(0,0,0,0.5)`,
                            transformStyle: "preserve-3d",
                        }}
                    >
                        <img src={ghibliImage} alt={ghibliTitle} style={{ width: "100%", height: "100%", objectFit: "cover" }} />
                    </motion.div>
                    <div style={{ maxWidth: 480 }}>
                        <div style={{ display: "flex", alignItems: "center", gap: 12, marginBottom: 16, color: accentColor }}>
                            <SparklesIcon size={28} />
                            <h2 style={{ fontSize: "clamp(32px, 4vw, 56px)", fontWeight: 700, margin: 0, letterSpacing: "-0.02em" }}>
                                {ghibliTitle}
                            </h2>
                        </div>
                        <p style={{ fontSize: 18, lineHeight: 1.7, opacity: 0.8 }}>
                            {ghibliDescription}
                        </p>
                    </div>
                </div>
            </motion.section>

            {/* ── SEZIONE CREATIVITÀ ── */}
            <motion.section
                style={{
                    height: "100vh",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    padding: "0 24px",
                    position: "relative",
                    y: creativityY,
                    opacity: creativityOpacity,
                    perspective: 1200,
                }}
            >
                <div style={{ display: "flex", alignItems: "center", gap: 60, maxWidth: 1200, width: "100%", flexWrap: "wrap", justifyContent: "center" }}>
                    <motion.div
                        whileHover={{ scale: 1.05, rotateY: 5 }}
                        transition={{ type: "spring", stiffness: 200, damping: 20 }}
                        style={{
                            width: cardWidth,
                            height: cardWidth * 1.2,
                            borderRadius: 24,
                            overflow: "hidden",
                            boxShadow: `0 40px 80px rgba(0,0,0,0.5)`,
                            transformStyle: "preserve-3d",
                        }}
                    >
                        <img src={creativityImage} alt={creativityTitle} style={{ width: "100%", height: "100%", objectFit: "cover" }} />
                    </motion.div>
                    <div style={{ maxWidth: 480 }}>
                        <div style={{ display: "flex", alignItems: "center", gap: 12, marginBottom: 16, color: accentColor }}>
                            <FilmIcon size={28} />
                            <h2 style={{ fontSize: "clamp(32px, 4vw, 56px)", fontWeight: 700, margin: 0, letterSpacing: "-0.02em" }}>
                                {creativityTitle}
                            </h2>
                        </div>
                        <p style={{ fontSize: 18, lineHeight: 1.7, opacity: 0.8 }}>
                            {creativityDescription}
                        </p>
                    </div>
                </div>
            </motion.section>
        </div>
    )
}

// ── CONTROLLI ──────────────────────────────────────────────────
addPropertyControls(AboutMePage, {
    name: { type: ControlType.String, title: "Nome", defaultValue: "Michele" },
    tagline: { type: ControlType.String, title: "Tagline", defaultValue: "Viaggiatore, sognatore, creatore di storie" },
    travelTitle: { type: ControlType.String, title: "Titolo Viaggi", defaultValue: "Viaggi" },
    travelDescription: { type: ControlType.String, title: "Descrizione Viaggi", defaultValue: "Ogni viaggio è una storia. Dalle strade di Copenhagen ai sentieri nascosti della mia terra, colleziono momenti, non cose. Ogni destinazione mi ha insegnato qualcosa di nuovo sul mondo e su me stesso." },
    travelImage: { type: ControlType.Image, title: "Immagine Viaggi" },
    ghibliTitle: { type: ControlType.String, title: "Titolo Ghibli", defaultValue: "Studio Ghibli" },
    ghibliDescription: { type: ControlType.String, title: "Descrizione Ghibli", defaultValue: "Il mio immaginario è popolato da spiriti della foresta, città incantate e macchine volanti. Miyazaki mi ha insegnato che la magia è ovunque, basta saper guardare. La mia creatività nasce da lì: da un mondo dove tutto è possibile." },
    ghibliImage: { type: ControlType.Image, title: "Immagine Ghibli" },
    creativityTitle: { type: ControlType.String, title: "Titolo Creatività", defaultValue: "Creatività" },
    creativityDescription: { type: ControlType.String, title: "Descrizione Creatività", defaultValue: "Traduco emozioni in codice, pixel e parole. Progetto esperienze digitali che spero lascino un segno, come un fotogramma di un film che ti rimane dentro." },
    creativityImage: { type: ControlType.Image, title: "Immagine Creatività" },
    bgColor: { type: ControlType.Color, title: "Sfondo", defaultValue: "#0A0A0A" },
    textColor: { type: ControlType.Color, title: "Testo", defaultValue: "#FFFFFF" },
    accentColor: { type: ControlType.Color, title: "Accento", defaultValue: "#0EA5E9" },
    cardWidth: { type: ControlType.Number, title: "Larghezza Card", defaultValue: 420, min: 280, max: 600, step: 10, unit: "px" },
})
